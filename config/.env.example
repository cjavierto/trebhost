# Copy this file to config/.env and fill in the values.
# One KEY=value per line. No spaces around "=". No comments on the same line as a value.

# --- Stripe (Developers > API keys) ---
# Use sk_test_... while testing. Swap to sk_live_... when you go live.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Signing secret for the webhook (Developers > Webhooks > your endpoint > Signing secret): whsec_...
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Admin login ---
# Your first password. After you change it in Admin > Settings, the new one is stored hashed and this is ignored.
ADMIN_PASSWORD=choose-a-long-password-here

# Random string, 32+ characters. Signs your login cookie and client payment links.
# Changing it later invalidates every payment link you've already sent.
APP_SECRET=replace-with-a-long-random-string-at-least-32-chars

# --- Site ---
# The public address of this site, no trailing slash.
APP_URL=https://pay.trebhost.co.nz

# Defaults for Settings (you can edit these in Admin > Settings afterwards)
BUSINESS_NAME=TrebHost
BILLING_EMAIL=billing@trebhost.co.nz

# Optional
# Address emails are sent from (must be a real mailbox on your domain for best delivery)
# MAIL_FROM=billing@trebhost.co.nz
TIMEZONE=Pacific/Auckland
CURRENCY=nzd
